# Copy to .env. config.py reads it (and DATA_DIR/.env) at start-up.
#
# NEVER commit a filled-in .env. .gitignore covers .env; verify before staging.

# Only needed with LLM_BACKEND=openai (the default is local Ollama): the API key the
# app uses for chat and embeddings.
OPENAI_API_KEY=sk-REPLACE_ME

# The embedder defaults to embeddinggemma-2 (text and figure images). Leave
# CITATION_EMBED_MODEL unset: a value here overrides the default, and an index
# refuses to open under an embedder other than the one that built it.

# Optional but polite. Unpaywall requires a contact address on every request,
# and OpenAlex/Crossref use it to route you to their faster pools. Leaving it
# unset falls back to config.py's placeholder, which is somebody else's address.
UNPAYWALL_EMAIL=you@example.com
