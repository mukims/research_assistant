.git
.gitignore
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local model + runtime data — never bake these into the image
model_final.pth
data/

# Secrets — .env is read from the data disk at run time, never from the image
.env
.env.*
!.env.example

# Agent / editor scratch, worktrees, agent instructions, CI config
.superpowers/
.worktrees/
.agents/
.claude/
.github/
GEMINI.md
ORIGINAL_REQUEST.md

# Not needed at run time: tests, design notes, guides that are not rendered in-app
tests/
notimportant/
*.pdf
ARCHITECTURE.md
PIPELINE.md
Research_Assistant_GROBID_Guide.md

# Layout extras are not installed in the deployed image
requirements-layout.txt
